
  {
    "extends": "./tsconfig.json",
        "compilerOptions": {
          "noEmit": false,
          "outDir": "./dist",
          "rootDir": ".",
          "module": "NodeNext",
          "moduleResolution": "NodeNext",
          "target": "ES2022",
          "baseUrl": ".",
          "paths": {
            "@shared/*": ["shared/*"],
            "@/*": ["client/src/*"]
          },
          "esModuleInterop": true,
          "resolveJsonModule": true,
          "skipLibCheck": true,
          "strict": true
        }
      }
    },
  "include": ["server/**/*", "client/**/*", "shared/**/*"],
  "exclude": ["client", "node_modules", "dist"]
}